<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Màn 01 · Splash native (androidx core-splashscreen, chạy cả Android < 12).
         Nền #F5FAFE, logo 184dp ở giữa. MainActivity giữ splash này đến khi
         Flutter vẽ xong frame đầu (đã có logo cùng vị trí) rồi mới ẩn. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Theme sau splash: nền cửa sổ phía sau Flutter UI cũng là #F5FAFE
         để không nháy trắng. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
