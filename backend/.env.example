NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://karvocab:karvocab@localhost:5433/karvocab
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
# mock | gemini | openai (openai = API chuẩn OpenAI: OpenRouter, OpenAI, Groq...)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
# mock | google
TTS_PROVIDER=mock
GOOGLE_APPLICATION_CREDENTIALS=
# local | s3
STORAGE_PROVIDER=local
PUBLIC_BASE_URL=http://localhost:3100
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# mock | fcm
PUSH_PROVIDER=mock
FIREBASE_SERVICE_ACCOUNT_PATH=
# console | resend
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=KarVocab <no-reply@karvocab.app>
# mock | real
SOCIAL_AUTH_MODE=mock
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
JOBS_ENABLED=true
